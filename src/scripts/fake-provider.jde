// fake-provider.jde — a stand-in inference provider for the parity gate.
//
// Built with `jade build --lib` and dropped into an active provider slot that
// JADE_PROVIDER_ACTIVE points at, so both engines load it exactly the way they
// load a real provider. It answers every prompt with the same canned reply, which
// is what makes examples/llm deterministic on both backends.
//
// This replaces scripts/fake-jaded.py, a stand-in *daemon* that served the same
// canned replies over a Unix socket. The socket is gone, so a stub has to be a
// package now — which is the better test anyway: it exercises the real path a
// released binary takes rather than one that no longer exists.
//
// The reply comes from JADE_FAKE_REPLY. A provider normally reads its config
// through `configure(opts)`, but an env var works identically under `jade run`
// and a compiled binary and needs no config.json staged beside the library.
//
// Both directions use the shared definition: `request` arrives as an
// `InferRequest`, and the reply is built from the `Token`/`Done`/`Error` structs
// declared alongside it. dovata's real providers are written against the same
// file, so the gate exercises the actual contract rather than a stand-in for it.
// Returning structs also covers the typed response path on both engines — a dict
// carrying the same names under `"type"` is still accepted.

use ovata::infer
use std::env

// One prompt, one reply, no state. Every fixture in examples/llm uses a single
// response for the whole file — async derefs finish in scheduling order, so a
// script of *different* replies would bind them to prompts non-deterministically
// and make the example flap.
fn infer(request) {
    // Read the field a real provider reads. Raising on nil is what makes a
    // rename in the shared definition fail the parity gate — a stub that merely
    // ignored the request would keep passing while every real provider broke.
    let input = request.input
    if input == nil || input == "" {
        return [infer.Error { message: "InferRequest.input was empty" }]
    }
    let reply = env.get("JADE_FAKE_REPLY")
    if reply == nil {
        return [infer.Error { message: "JADE_FAKE_REPLY is not set" }]
    }
    // Built with push rather than as one literal: an array literal must be
    // homogeneous, and `[Token {...}, Done {...}]` is two struct types, so the
    // literal is a type error. Frames written as dicts have no such problem —
    // every dict is one type — which is why the dict form stays supported.
    let frames = []
    frames.push(infer.Token { text: reply })
    frames.push(infer.Done { tokens_used: 1 })
    return frames
}

// Accepted and ignored. The engines only call this when a config.json is staged,
// which the parity harness does not do, but a provider that lacks it entirely is
// an unusual shape to be testing against.
fn configure(opts) {
    return nil
}
