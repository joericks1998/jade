// ── arrays ────────────────────────────────────────────────────────────────────

// Array literal
let a = [1, 2, 3]
print(a)   // [1, 2, 3]

// Empty array
let empty = []
print(empty)   // []

// Heterogeneous elements (int, float, bool, string)
let mixed = [1, 2.0, true, "hello"]
print(mixed)   // [1, 2.0, true, hello]

// Indexing — zero-based
print(a[0])   // 1
print(a[2])   // 3

// len builtin works on arrays and strings
print(len(a))        // 3
print(len(empty))    // 0
print(len("hello"))  // 5

// Index assignment — value semantics: b is an independent copy of a
let b = a
b[0] = 42
print(b[0])   // 42
print(a[0])   // 1  (a is unchanged)

// Mutate a directly
a[1] = 99
print(a[1])   // 99

// Trailing comma is allowed
let t = [10, 20, 30,]
print(len(t))   // 3

// Nested arrays
let matrix = [[1, 2], [3, 4]]
print(matrix[0][1])   // 2
print(matrix[1][0])   // 3

// Arrays in functions
fn sum(arr, n) {
    let i = 0
    let total = 0
    while i < n {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

let nums = [10, 20, 30]
print(sum(nums, len(nums)))   // 60
