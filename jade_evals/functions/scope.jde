// Global scoping: all let bindings live in one flat env.
// Function params and locals are visible at the top level after a call returns.

fn set_value() {
    let x = 42
    return x
}

fn double_param(n) {
    let result = n * 2
    return result
}

let a = set_value()
// x == 42  (written globally by set_value)
// a == 42

let b = double_param(7)
// n == 7   (parameter binding is global)
// result == 14
// b == 14
