fn factorial(n) {
    if n == 0 {
        return 1
    }
    return n * factorial(n - 1)
}

fn fib(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

let f0 = factorial(0)
let f1 = factorial(1)
let f5 = factorial(5)
let fib0 = fib(0)
let fib1 = fib(1)
let fib10 = fib(10)
