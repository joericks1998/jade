// Recursive functions — each call gets its own scope, so recursive calls
// do not overwrite the caller's parameters or locals.

fn factorial(n) {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn fib(n) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn sum_to(n) {
    if n <= 0 {
        return 0
    }
    return n + sum_to(n - 1)
}

let f0 = factorial(0)    // 1
let f1 = factorial(1)    // 1
let f5 = factorial(5)    // 120
let f7 = factorial(7)    // 5040

let fib0  = fib(0)       // 0
let fib1  = fib(1)       // 1
let fib10 = fib(10)      // 55

let s0  = sum_to(0)      // 0
let s10 = sum_to(10)     // 55
