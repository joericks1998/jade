// Sum 1 + 2 + ... + 10
let n = 10
let sum = 0
let i = 1
while i <= n {
    sum = sum + i
    i = i + 1
}
// sum == 55

// Product: 5! = 120
let result = 1
let k = 1
while k <= 5 {
    result = result * k
    k = k + 1
}
// result == 120

// Count multiples of 3 up to 30
let count = 0
let x = 3
while x <= 30 {
    count = count + 1
    x = x + 3
}
// count == 10

// Geometric: double until >= 100
let val = 1
while val < 100 {
    val = val * 2
}
// val == 128
