# ignore virtual environment setup
venv/

# ignore claude planning
planning/

# ignore Python cache
__pycache__/

# ignore test text files
*.txt

# ...but an example's canned LLM script is part of the example, not scratch.
# Without these the stand-in daemon falls back to its default reply, every typed
# deref fails to coerce, and the parity gate fails in CI while passing locally.
!examples/**/responses.txt

*/.DS_Store


# npm never runs at the repo root — the only Node project is docs/, which has its
# own .gitignore. A stray `npm install` here once left an empty package-lock.json
# behind that locked nothing and made the root look like a JS project; this stops
# the next one leaving anything at all.
node_modules/
/package-lock.json

# Added by cargo

/target

.claude/


CLAUDE.md

*.icloud