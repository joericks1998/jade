// std::env: the process environment.
//
// A variable is set by whoever started the program, so its value is tainted.
// The arguments and the working directory are the program's own, as in v1, so
// they are trusted. Each function is one hook: reading the environment marks
// what it brings in tainted inside the hook, where library code cannot skip
// it.

use std::__sys

// Purpose: This function reads a variable: its value, tainted, or nil when it
// is not set or its value is not UTF-8, as Rust's `env::var` gave.
fn get(name) {
    return __sys.getenv(str(name))
}

// Purpose: This function sets a variable for the program and the commands it
// starts from now on.
fn set(name, value) {
    __sys.setenv(str(name), str(value))
}

// Purpose: This function returns the program's arguments, its own path first.
fn args() {
    return __sys.args()
}

// Purpose: This function returns the working directory, or "" when it cannot
// be read.
fn cwd() {
    return __sys.cwd()
}
