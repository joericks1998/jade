// std::math: rounding, abs, min and max, powers and roots, logarithms,
// trigonometry, the two predicates, and the constants.
//
// A function that is one instruction calls the LLVM intrinsic or C library
// function behind it through `__sys`; the backend's optimizer inlines the
// call, so it costs nothing. The rest is written here. Results match v1's,
// which used Rust's `f64` methods: `round` takes halves away from zero, a
// float becomes an int by saturating, and `min` and `max` of a NaN and a
// number give the number.
//
// A function works on an int or a float. `x is int` here asks which one the
// checker settled, for the copy of the function it is checking, so each copy
// keeps only the branch for its own kind. An int stays an int where the
// answer can be one; anything else is worked out as a float.

use std::__sys

// Purpose: This function rounds down to an int.
fn floor(x) {
    if x is int {
        return x
    } else {
        return __sys.to_int(__sys.floor(float(x)))
    }
}

// Purpose: This function rounds up to an int.
fn ceil(x) {
    if x is int {
        return x
    } else {
        return __sys.to_int(__sys.ceil(float(x)))
    }
}

// Purpose: This function gives a number's size, of the same kind. The most
// negative int has no positive twin, so it raises.
fn abs(x) {
    if x is int {
        if x < 0 {
            return -x
        }
        return x
    } else {
        return __sys.fabs(float(x))
    }
}

// Purpose: This function returns the square root, NaN for a negative.
fn sqrt(x) {
    return __sys.sqrt(float(x))
}

// Purpose: This function returns the smaller of two numbers: an int when
// both are, and otherwise a float, where a NaN gives way to the other.
fn min(a, b) {
    if a is int and b is int {
        if a < b {
            return a
        }
        return b
    } else {
        return __sys.minnum(float(a), float(b))
    }
}

// Purpose: This function returns the larger of two numbers, the way `min`
// returns the smaller.
fn max(a, b) {
    if a is int and b is int {
        if a > b {
            return a
        }
        return b
    } else {
        return __sys.maxnum(float(a), float(b))
    }
}

// Purpose: This function raises a number to a power. Two ints give an int,
// by squaring and multiplying, and raise on overflow or on a negative
// exponent; a float base with an int exponent multiplies; anything else is
// C's `pow`.
fn pow(base, exp) {
    if base is int and exp is int {
        return _pow_int(base, exp)
    } elif exp is int {
        return __sys.powi(float(base), exp)
    } else {
        return __sys.pow(float(base), float(exp))
    }
}

// Purpose: This function rounds to the nearest int, halves away from zero.
fn round(x) {
    if x is int {
        return x
    } else {
        return __sys.to_int(__sys.round(float(x)))
    }
}

// Purpose: This function rounds toward zero to an int.
fn trunc(x) {
    if x is int {
        return x
    } else {
        return __sys.to_int(__sys.trunc(float(x)))
    }
}

// Purpose: This function gives -1, 0 or 1 by a number's sign, of the same
// kind. A float zero of either sign gives 0.0, and NaN gives NaN.
fn sign(x) {
    if x is int {
        if x > 0 {
            return 1
        }
        if x < 0 {
            return -1
        }
        return 0
    } else {
        let v = float(x)
        if v != v {
            return v
        }
        if v == 0.0 {
            return 0.0
        }
        return __sys.copysign(1.0, v)
    }
}

// Purpose: This function returns the natural logarithm.
fn ln(x) {
    return __sys.ln(float(x))
}

// Purpose: This function returns the base-2 logarithm.
fn log2(x) {
    return __sys.log2(float(x))
}

// Purpose: This function returns the base-10 logarithm.
fn log10(x) {
    return __sys.log10(float(x))
}

// Purpose: This function returns e to a power.
fn exp(x) {
    return __sys.exp(float(x))
}

// Purpose: This function returns the sine of an angle in radians.
fn sin(x) {
    return __sys.sin(float(x))
}

// Purpose: This function returns the cosine of an angle in radians.
fn cos(x) {
    return __sys.cos(float(x))
}

// Purpose: This function returns the tangent of an angle in radians.
fn tan(x) {
    return __sys.tan(float(x))
}

// Purpose: This function returns the arcsine, in radians.
fn asin(x) {
    return __sys.asin(float(x))
}

// Purpose: This function returns the arccosine, in radians.
fn acos(x) {
    return __sys.acos(float(x))
}

// Purpose: This function returns the arctangent, in radians.
fn atan(x) {
    return __sys.atan(float(x))
}

// Purpose: This function returns the angle of the point (x, y), in radians.
// It takes y first, as C does.
fn atan2(y, x) {
    return __sys.atan2(float(y), float(x))
}

// Purpose: This function returns the length of the hypotenuse.
fn hypot(a, b) {
    return __sys.hypot(float(a), float(b))
}

// Purpose: This function keeps a number within a range: `max(x, lo)`, then
// `min` of that and `hi`, so a reversed range gives `hi`. An int when all
// three are.
fn clamp(x, lo, hi) {
    if x is int and lo is int and hi is int {
        return min(max(x, lo), hi)
    } else {
        return min(max(float(x), float(lo)), float(hi))
    }
}

// Purpose: This function says whether a number is NaN. An int never is.
fn is_nan(x) {
    if x is int {
        return false
    } else {
        let v = float(x)
        return v != v
    }
}

// Purpose: This function says whether a number is infinite. An int never is.
fn is_inf(x) {
    if x is int {
        return false
    } else {
        return __sys.fabs(float(x)) == inf()
    }
}

// Purpose: This function returns pi.
fn pi() {
    return 3.141592653589793
}

// Purpose: This function returns e.
fn e() {
    return 2.718281828459045
}

// Purpose: This function returns tau, two pi.
fn tau() {
    return 6.283185307179586
}

// Purpose: This function returns positive infinity, which no literal can
// write.
fn inf() {
    return __sys.float_bits(0x7FF0000000000000)
}

// Purpose: This function returns NaN, which no literal can write.
fn nan() {
    return __sys.float_bits(0x7FF8000000000000)
}

// Purpose: This function raises an int to an int power by squaring.
fn _pow_int(base, exp) {
    if exp < 0 {
        raise "math.pow of two ints needs an exponent of 0 or more; pass a float to get a fraction"
    }
    let result = 1
    let square = base
    let rest = exp
    while rest > 0 {
        if rest % 2 == 1 {
            result = result * square
        }
        rest = rest / 2
        if rest > 0 {
            square = square * square
        }
    }
    return result
}
