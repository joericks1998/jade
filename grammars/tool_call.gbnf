# Jade tool-call grammar (GBNF, llama.cpp constrained decoding).
#
# Mirrors the native Qwen/Hermes tool-call grammar proven in live Jade programs
# (programs/lib/tools.jde). A tool call is a JSON object with a string `"name"`
# followed by an `"arguments"` object:
#
#     <tool_call>{ "name": "get_weather", "arguments": { "city": "SF" } }</tool_call>
#
# This grammar covers only the JSON *body*. The model-specific delimiters that
# wrap it (`<tool_call>` / `</tool_call>` for Qwen) are supplied out-of-band via
# the request `anchor` / `stop_anchor` from the active model profile
# (src/llm/model_profile.rs), so the body grammar is reusable across models.
#
# jade-tree defers grammar enforcement until the open delimiter appears and
# retires it when the JSON span closes, so prose before/between calls streams
# unconstrained and only the JSON payload is grammar-checked.
#
# `root` is the start rule, matching llama-cpp-2's
# `LlamaSampler::grammar(model, gbnf, "root")` convention.

root ::= "{" ws "\"name\"" ws ":" ws str ws "," ws "\"arguments\"" ws ":" ws obj ws "}"
pair ::= str ws ":" ws val
val  ::= str | num | obj | arr | "true" | "false" | "null"
obj  ::= "{" ws ( pair ( ws "," ws pair )* )? ws "}"
arr  ::= "[" ws ( val ( ws "," ws val )* )? ws "]"
str  ::= "\"" ( [^"\\] | "\\" . )* "\""
num  ::= "-"? [0-9]+ ( "." [0-9]+ )?
ws   ::= [ ]*
