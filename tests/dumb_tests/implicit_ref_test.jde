# ===================================
# Jade Implicit Reference Test
# ===================================
# Tests: using a prompt variable name without ? operator
# Expected: bare identifier resolves to the __p__ prefixed variable

print("=" * 50)
print("IMPLICIT REFERENCE TEST")
print("=" * 50)

# Declare a prompt
prompt greeting = "Say hello in one word"

# Dereference with ? (explicit)
explicit_result = ?greeting
print(f"Explicit (?greeting): {explicit_result}")

# Declare another prompt
prompt farewell = "Say goodbye in one word"

# Use bare identifier (implicit) - should resolve to __p__farewell
print(f"farewell: {farewell}")

# ===================================
# F-String Tokenization Tests
# ===================================

print("")
print("=" * 50)
print("F-STRING TOKENIZATION TEST")
print("=" * 50)

# Test 1: Basic f-string with variable
name = "Jade"
print(f"Hello from {name}!")

# Test 2: F-string with expression
x = 10
y = 20
print(f"Sum: {x + y}")

# Test 3: F-string with prompt dereference result
prompt f = "Say hi in one word"
hi_result = ?f
print(f"Prompt named f returned: {hi_result}")

# Test 4: F-string still works after declaring prompt named 'f'
lang = "Jade"
version = 1
print(f"{lang} version {version}")

# Test 5: Single-quoted f-string
color = "green"
print(f'The color is {color}')

print("=" * 50)
print("F-STRING TOKENIZATION TEST COMPLETED!")
print("=" * 50)
