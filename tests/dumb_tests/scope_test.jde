# ===================================
# Jade Scope Test - Cross-Scope Prompt
# ===================================
# Tests: prompt defined inside a function,
# dereferenced outside the function

print("=" * 50)
print("SCOPE TEST: Prompt in function, deref outside")
print("=" * 50)

def generate_prompt():
    prompt scoped_msg = "Say 'I was defined inside a function'"
    print("Prompt registered inside function.")

generate_prompt()

result = ?scoped_msg
print(f"Result: {result}")

print("=" * 50)
print("SCOPE TEST COMPLETED!")
print("=" * 50)