# ===================================
# Jade Typed Output Test
# ===================================
print("=== Typed Output Test ===")
print()

# --- int ---
print("-- int --")
prompt p_int = "How many legs does a spider have?"
result = ?p_int -> int
print("Spider legs:", result)
print("Type:", type(result).__name__)
print()

# --- float ---
print("-- float --")
prompt p_float = "What is the value of pi to four decimal places? Give only the number."
result = ?p_float -> float
print("Pi:", result)
print("Type:", type(result).__name__)
print()

# --- bool ---
print("-- bool --")
prompt p_bool = "Is the Earth round?"
result = ?p_bool -> bool
print("Earth is round:", result)
print("Type:", type(result).__name__)
print()

# --- custom class ---
print("-- custom class --")

class Celsius:
    def __init__(self, value):
        try:
            self.value = float(value)
        except Exception as e:
            raise ValueError("What you entered '{value}' is not a float, you must enter a float")
    def __repr__(self):
        return f"Celsius({self.value})"

prompt p_temp = "What is the boiling point of water in Celsius? Give only the number."
temp = ?p_temp -> Celsius
print("Boiling point:", temp)
print("Type:", type(temp).__name__)
print()

# --- retry log ---
print("-- retry log --")
print("Retry log entries:", len(__retry_log__))
if len(__retry_log__) > 0:
    for entry in __retry_log__:
        print(" prompt:", entry["prompt"])
        print(" type:", entry["type"])
        print(" attempts:", entry["attempts"])
        print(" success:", entry["success"])
        print(" failed responses:", entry["failed"])
        print()

# --- max retries builtin ---
print("-- max retries --")
print("Default max retries:", __max_retries__)
__max_retries__ = 2
print("After setting to 2:", __max_retries__)
print()

print("=== Typed Output Test Complete ===")
