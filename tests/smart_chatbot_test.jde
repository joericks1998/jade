# ===================================
# Jade Smart Chatbot
# - Live token + message tracking
# - Auto-clears context at TOKEN_LIMIT
# ===================================

TOKEN_LIMIT = 5000

print("=" * 60)
print("  JADE SMART CHATBOT")
print("  Type your message, or Q to quit.")
print("=" * 60)
print()

while True:
    token_count = __tokens__
    msg_count = len(__messages__)
    print(f"  [ model: {__model__}  |  tokens: {token_count}  |  messages: {msg_count} ]")

    prompt p = input("You: ")
    print()

    if p.upper() == "Q":
        print(f"  Goodbye! Session used {__tokens__} tokens total.")
        break

    print("Jade: ", end="")
    response = ?p
    print()
    print()

    if __tokens__ > TOKEN_LIMIT:
        print(f"  *** Token limit ({TOKEN_LIMIT}) reached — clearing context. ***")
        __clear__()
        print()
