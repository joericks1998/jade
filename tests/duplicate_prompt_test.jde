# ===================================
# Jade Duplicate Prompt Test
# ===================================
# Tests: two prompts declared with the same name
# Expected: second prompt overwrites the first

print("=" * 50)
print("DUPLICATE PROMPT TEST")
print("=" * 50)

# Define a prompt named 'msg'
prompt msg = "Say 'I am the FIRST prompt'"

# Redefine the same prompt name with different text
prompt msg = "Say 'I am the SECOND prompt'"

# Dereference - should get the second prompt's response
result = ?msg
print(f"Result: {result}")

print("=" * 50)
print("DUPLICATE PROMPT TEST COMPLETED!")
print("=" * 50)