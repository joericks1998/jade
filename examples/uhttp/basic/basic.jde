use std::uhttp
use std::json
use std::fs

// HTTP over a Unix domain socket. The target is a single pseudo-URL of the form
// unix://<socket-path>:<request-path> — here the Docker Engine API.
// Every function returns a Dict { "status": int, "body": str }, mirroring std/http.

// GET — list running containers
let r = uhttp.get("unix:///var/run/docker.sock:/v1.43/containers/json")
print(r["status"])                          // 200
let containers = json.parse(r["body"])
print(containers.len())

// POST with body — create a container (JSON payload + Content-Type header)
let spec = json.stringify({"Image": "alpine", "Cmd": ["echo", "hi"]})
let c = uhttp.post(
    "unix:///var/run/docker.sock:/v1.43/containers/create",
    spec,
    {"Content-Type": "application/json"}
)
print(c["status"])                          // 201

// DELETE — remove a container by id
let d = uhttp.delete("unix:///var/run/docker.sock:/v1.43/containers/deadbeef?force=true")
print(d["status"])                          // 204

// HEAD — body is empty, status reflects the resource
let h = uhttp.head("unix:///var/run/docker.sock:/_ping")
print(h["status"])                          // 200
print(h["body"])                            // (empty string)

// GET with a request path that defaults to "/" when omitted
let ping = uhttp.get("unix:///var/run/docker.sock:/_ping")
print(ping["body"])                         // OK

// ── Bodies that are not text ────────────────────────────────────────────────
//
// Everything above reads `body` as a str, which is UTF-8 and NUL-terminated. A
// daemon answering with an image, an audio frame, or a gzip stream breaks both
// rules: invalid sequences become "?" and the body is cut at its first NUL. So
// those use get_bytes / post_bytes, whose `body` is a `bytes` value instead.

let img = uhttp.get_bytes("unix:///var/run/docker.sock:/v1.43/images/alpine/get")
print(img["status"])                        // 200
print(len(img["body"]))                     // octets, not characters
print(img["body"][0])                       // an int in 0..=255, not a char

// Sending octets works the same way round: the body must be a `bytes` value,
// and a str is a type error rather than a silent encode.
let wav = fs.read_bytes("clip.wav")
let up = uhttp.post_bytes(
    "unix:///var/run/audiod.sock:/play",
    wav,
    {"Content-Type": "audio/wav"}
)
print(up["status"])                         // 200

// A reply is TAINTED whichever spelling produced it, so it cannot reach a sink
// like sh.exec without being explicitly trusted — same rule as fs.read_bytes.
