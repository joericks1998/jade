// A typed dereference pipes like any other value.
//
// `toInt(?p)` asks the model for an int and gives one, so it is one piece: the
// stages after it run once, on the int. A pipe straight after `?p` would run
// once per piece of the reply's text instead.

fn double(x) {
    return x * 2
}

fn describe(n) {
    return f"got {n}"
}

prompt p = "What is 21 + 21? Respond with only the number."

// The model is asked for an integer, and `double` receives a real int rather
// than a string.
let n = toInt(?p) |> double
print(n)

// Chains keep going, left to right.
print(toInt(?p) |> double |> describe)
