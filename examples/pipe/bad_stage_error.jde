// A pipe stage has to be a function, called once per piece.
//
// `5 |> 3` asks to pipe a value into an integer, which means nothing. The
// stage survives into the AST and type inference rejects it, so the error can
// say what the stage turned out to be.

fn double(x) {
    return x * 2
}

let ok = 5 |> double
print(ok)

// The stage is an int, not something callable.
let bad = 5 |> 3
print(bad)
