// ── pipe operator |> ──────────────────────────────────────────────────────────
//
// A pipe calls its stages once per piece of the value on its left. Every value
// here is one piece, so each pipe is one call; per_piece/ shows a stream.

fn double(x) {
    return x * 2
}

fn add(a, b) {
    return a + b
}

fn greet(name) {
    return f"hello, {name}!"
}

// Simple pipe: value |> function (the function receives the value as its sole
// argument)
let n = 5 |> double
print(n)   // 10

// A chain runs left to right: 3 |> double |> double is double(double(3))
let m = 3 |> double |> double
print(m)   // 12

// Pipe directly to print
"piped string" |> print

// A stage with arguments: the value goes in front of them
let r = 5 |> add(3)
print(r)   // 8

// Pipe works with string functions
let greeting = "Jade" |> greet
print(greeting)   // hello, Jade!

// Pipe with arithmetic on the left
let x = (2 + 3) |> double
print(x)   // 10
