// `char` crossing the FFI, and the two conversions that make a fixed-size C
// field readable.
//
// A C `char[32]` arrives as thirty-two characters, NUL padding included —
// nothing is trimmed, because trimming would guess where the text stops. So
// `toInt(c)` is how a program finds that itself, and `toChar(n)` builds one from
// a number for the write direction.

let c = toChar("j")
print(c)
print(toInt(c))
print(toChar(106))
print(toChar(106) == "j")

// Unicode, not bytes: a scalar above 255 survives in both directions.
print(toInt(toChar("中")))
print(toChar(20013))

// Reading a fixed-size field the way C does: stop at the first NUL.
let field = [toChar("p"), toChar("u"), toChar("s"), toChar("h"), toChar(0), toChar(0), toChar(0)]
let text = ""
for ch in field {
    if (toInt(ch) == 0) {
        break
    }
    text = text + ch
}
print(text)
print(text.len())

// A number that is not a character is refused rather than replaced.
try {
    print(toChar(1114112))
} catch e {
    print("refused")
}
