// Nested function calls: each call binds its params globally,
// so inner calls overwrite the globals set by outer calls.

fn add(a, b) {
    return a + b
}

fn double(x) {
    return x * 2
}

fn square(x) {
    return x * x
}

fn double_sum(a, b) {
    return double(add(a, b))
}

fn sum_of_squares(a, b) {
    return add(square(a), square(b))
}

fn apply_twice(f, x) {
    return f(f(x))
}

fn pipeline(a, b) {
    return double(square(add(a, b)))
}

let ds = double_sum(3, 4)
// double_sum: a == 3, b == 4
// add(3, 4): a == 3, b == 4, returns 7
// double(7): x == 7, returns 14
// ds == 14

let ss = sum_of_squares(3, 4)
// sum_of_squares: a == 3, b == 4
// square(3): x == 3, returns 9
// square(4): x == 4, returns 16
// add(9, 16): a == 9, b == 16, returns 25
// ss == 25

let at = apply_twice(double, 3)
// apply_twice: f == double, x == 3
// double(3): x == 3, returns 6
// double(6): x == 6, returns 12
// at == 12

let ats = apply_twice(square, 2)
// apply_twice: f == square, x == 2
// square(2): x == 2, returns 4
// square(4): x == 4, returns 16
// ats == 16

let pipe = pipeline(1, 2)
// pipeline: a == 1, b == 2
// add(1, 2): a == 1, b == 2, returns 3
// square(3): x == 3, returns 9
// double(9): x == 9, returns 18
// pipe == 18
