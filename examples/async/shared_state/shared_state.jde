// The same work, written so it cannot race: values go in as parameters and
// results come back out through the future. No shared mutation, so no lock and
// no copy is needed — and the result does not depend on which task ran first.

async fn bump(n) {
    return n + 1
}

// Each task owns its input and returns its own result.
let results = join(bump(0), bump(10), bump(100))
print(results[0])
print(results[1])
print(results[2])
// → 1
// → 11
// → 101


// A task may freely mutate anything it allocated itself — `out` is unaliased,
// so pushing to it races with nothing.
async fn build(n) {
    let out = []
    out.push(n)
    out.push(n * 2)
    return out
}

let r = await build(3)
print(r[0])
print(r[1])
// → 3
// → 6
