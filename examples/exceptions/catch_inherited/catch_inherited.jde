// A typed catch arm follows inheritance.
//
// `catch Failure e` catches anything that inherits `Failure`, which is what
// makes a shared parent worth raising through: one arm handles a family of
// errors, and adding a new member does not mean editing every caller.
//
// It does not run the other way. A `NotFound` arm is asking for that type in
// particular, so a plain `Failure` walks past it.
//
// Inside an arm, `e` has the type the arm names. A `Failure` arm reads the
// fields every Failure has; to read a child's own field, name the child in the
// arm. catch_parent_reads_child_error.jde pins the refusal.

class Failure {
    @public reason
}

class NotFound(Failure) {
    @public path
}

class Timeout(Failure) {
    @public let seconds = 30
}

// The parent's arm catches the child.
try {
    raise NotFound { reason: "gone", path: "/tmp/x" }
} catch Failure e {
    print("parent arm caught it")
    print(e.reason)
} catch e {
    print("WRONG: fell through to the untyped arm")
}

// A sibling is not a parent, so the first arm does not take it.
try {
    raise Timeout { reason: "slow" }
} catch NotFound e {
    print("WRONG: a sibling arm caught it")
} catch Failure e {
    print("sibling skipped, parent caught")
    print(e.reason)
}

// The exact type still matches, which is what every arm did before.
try {
    raise Failure { reason: "plain" }
} catch NotFound e {
    print("WRONG: a child arm caught a parent")
} catch Failure e {
    print("exact match still works")
}

// Arms are tried in order, so a child arm placed first takes the child.
try {
    raise NotFound { reason: "gone", path: "/tmp/y" }
} catch NotFound e {
    print("the nearer arm wins when it is written first")
    print(e.path)
} catch Failure e {
    print("WRONG: the parent arm took it")
}
