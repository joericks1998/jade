// Returning out of a `try` must not leave its handler behind.
//
// Regression fixture. The emitter puts `PopHandler` on the try body's normal
// fall-through exit only, so `try { …; return x } catch e { … }` returned with
// its handler still registered. In the VM that is harmless — the handler stack
// is a local of the call frame, so it dies with the function. The compiled
// backend used one thread-wide stack that nothing unwound on return, so the
// dead entry stayed, still pointing at a `jmp_buf` in a stack frame that had
// already returned.
//
// The next `raise` then longjmp'd into that dead frame. What happened next
// depended on what had since overwritten the stack: a segfault when the buffer
// was obvious garbage, an infinite spin when the stale bytes looked like a
// plausible jump target, and a wrong-looking error when it landed in a live but
// incorrect handler. Nondeterministic enough to read as heap corruption, which
// is why it was the trigger that stayed unexplained the longest.
//
// The shape below is the one that actually fails: the leak has to happen INSIDE
// an enclosing try, so the dead handler sits ON TOP of the live one and the
// throw reaches for it first. A raise with its own handler pushed last always
// found the right frame and looked fine.

fn returns_from_try() {
  try {
    return "returned out of the try"
  } catch e {
    return "caught"
  }
}

fn returns_from_catch() {
  try {
    raise "inner"
  } catch e {
    return "returned out of the catch"
  }
}

try {
  print(returns_from_try())      // returned out of the try
  print(returns_from_catch())    // returned out of the catch
  raise "boom"
} catch e {
  print(f"caught: {e}")          // caught: boom
}

// Many leaks, then the same test — the handler stack is bounded, so a leak per
// call would also eventually overflow it outright.
fn leak(i) {
  try {
    return i
  } catch e {
    return -1
  }
}

try {
  let i = 0
  while i < 200 {
    leak(i)
    i = i + 1
  }
  raise "after many"
} catch e {
  print(f"caught: {e}")          // caught: after many
}

// Nested try, returning from the inner one: both frames must come off.
fn nested() {
  try {
    try {
      return "from the inner try"
    } catch inner {
      return "inner caught"
    }
  } catch outer {
    return "outer caught"
  }
}

try {
  print(nested())                // from the inner try
  raise "still fine"
} catch e {
  print(f"caught: {e}")          // caught: still fine
}

print("done")
