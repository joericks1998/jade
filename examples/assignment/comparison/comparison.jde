let eq_true = 3 == 3         // true
let eq_false = 3 == 4        // false
let ne_true = 3 != 4         // true
let ne_false = 3 != 3        // false

let lt_true = 1 < 2          // true
let lt_false = 2 < 1         // false
let gt_true = 2 > 1          // true
let gt_false = 1 > 2         // false
let le_equal = 2 <= 2        // true
let le_less = 1 <= 2         // true
let ge_equal = 2 >= 2        // true
let ge_greater = 3 >= 2      // true

let float_eq = 1.5 == 1.5    // true
let float_lt = 1.0 < 2.0     // true
let float_gt = 2.5 > 1.5     // true

// bool ordering: false == 0, true == 1
let bool_lt = false < true   // true
let bool_gt = true > false   // true
let bool_eq = true == true   // true

let compare_chain = 1 < 2 && 3 > 0  // true
