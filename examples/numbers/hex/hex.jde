// Hex integer literals.
//
// `0x` or `0X`, then hex digits in either case, is an int like any other. The
// range is the int's: 0x7fffffffffffffff is the largest, and -0x8000000000000000
// the smallest, written with a minus as a decimal literal is. hex_digit_error.jde
// shows a letter that is not a hex digit refused.

print(0x11)
print(0xff + 1)
print(0XAbC)
print(0x0f & 0x3c)
print(0x7fffffffffffffff)
print(-0x8000000000000000)
print(f"{0x10} in hex is 16")
