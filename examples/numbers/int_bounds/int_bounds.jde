// The ends of the integer range are both writable, and both engines agree.
//
// A Jade integer is 63-bit and the range is asymmetric: INT_MAX is 2^62 - 1 and
// INT_MIN is -(2^62). A literal is lexed without its sign — `-` is a separate
// token the parser applies — so bounding the bare magnitude at INT_MAX meant
// the magnitude of INT_MIN, which is one larger, was rejected. The smallest
// representable integer could not be written down at all.

let lo = -4611686018427387904
let hi = 4611686018427387903

print(lo)
print(hi)
// → -4611686018427387904
// → 4611686018427387903

// They are ordinary integers.
print(lo + 1)
print(hi - 1)
print(lo < hi)
// → -4611686018427387903
// → 4611686018427387902
// → true

// And the ends are still ends: stepping past either one overflows rather than
// wrapping.
try {
    let x = lo - 1
    print(x)
} catch e {
    print("underflow caught")
}
// → underflow caught

try {
    let x = hi + 1
    print(x)
} catch e {
    print("overflow caught")
}
// → overflow caught
