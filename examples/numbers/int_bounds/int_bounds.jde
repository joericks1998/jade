// The ends of the integer range, and what happens just past them.
//
// A Jade 2.0 int is a full signed 64-bit integer, so the range runs from
// -9223372036854775808 to 9223372036854775807. A result past either end raises
// `integer overflow` rather than wrapping.
//
// The bounds are built by arithmetic here, because a literal is still limited to
// 2^62 until the tagged backend, whose ints are 63-bit, is removed. For the same
// reason this example runs only on the static backend.

let hi = 4611686018427387903 * 2 + 1
let lo = -hi - 1

print(lo)
print(hi)
print(lo + 1)
print(hi - 1)
print(lo < hi)

try {
    let x = lo - 1
    print(x)
} catch e {
    print("underflow caught")
}

try {
    let x = hi + 1
    print(x)
} catch e {
    print("overflow caught")
}
