// std::fs's two standard streams: read_stdin_bytes and write_stdout_bytes.
//
// A fixture cannot choose what its own standard input holds, so it runs
// itself as a child, through the shell, with the input it wants and an
// argument that says what to do with it. env.args() is the program's own, so
// its path is trusted as part of a command.

use std::env
use std::fs
use std::sh

let args = env.args()
if len(args) > 1 {
    let mode = args[1]
    if mode == "echo" {
        fs.write_stdout_bytes(fs.read_stdin_bytes())
    } elif mode == "count" {
        print(len(fs.read_stdin_bytes()))
    } elif mode == "taint" {
        let text = fs.read_stdin_bytes().decode()
        try {
            sh.exec(text)
            print("NOT REFUSED")
        } catch e {
            print("standard input is refused")
        }
    }
} else {
    let me = "'" + args[0] + "'"
    // What goes in comes out, byte for byte: a NUL and a byte that is not
    // UTF-8 included.
    print(sh.exec("printf 'abc' | " + me + " echo"))
    print(sh.exec("printf 'a\\000b\\377' | " + me + " echo | wc -c").trim())
    print(len(sh.exec(me + " echo < /dev/null")))
    // More than one read of the C library's.
    print(sh.exec("head -c 200000 /dev/zero | " + me + " count"))
    print(sh.exec(me + " count < /dev/null"))
    // Standard input came from outside the program.
    print(sh.exec("printf 'echo hi' | " + me + " taint"))
}
