// Basic class definitions, instantiation, field access, field mutation,
// methods, and method calls.

class Point {
    @public x,
    @public y
}

class Counter {
    @public count

    @public fn increment()
    @public fn value()
}

// Instantiation and field access
let p = Point { x: 10, y: 20 }
let px = p.x
// px == 10
let py = p.y
// py == 20

// Field mutation
p.x = 99
let updated_x = p.x
// updated_x == 99

// Methods declared in the class and defined outside it. `self` is the receiver,
// and it is never listed among the parameters.
fn Counter::increment() {
    self.count = self.count + 1
}

fn Counter::value() {
    return self.count
}

let c = Counter { count: 0 }
c.increment()
c.increment()
let v = c.value()
// v == 2
