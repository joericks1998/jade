// Two parents may not declare the same field.
//
// This is the same rule as `inherit_field_clash_error.jde`, reached from the
// other direction: a name appears once across a class and everything it
// inherits, however many steps away the other declaration is.

class Winged {
    span
}

class Finned {
    span
}

class Griffin(Winged, Finned) {
    name
}
