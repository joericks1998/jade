fn sign(x) {
    if x > 0 {
        return 1
    } else {
        if x < 0 {
            return -1
        } else {
            return 0
        }
    }
}

fn quadrant(a, b) {
    if a > 0 {
        if b > 0 {
            return 1
        } else {
            return 4
        }
    } else {
        if b > 0 {
            return 2
        } else {
            return 3
        }
    }
}

fn between(x, lo, hi) {
    if x >= lo {
        if x <= hi {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

let s1 = sign(10)               // 1
let s2 = sign(-5)               // -1
let s3 = sign(0)                // 0
let q1 = quadrant(1, 1)         // 1
let q2 = quadrant(-1, 1)        // 2
let q3 = quadrant(-1, -1)       // 3
let q4 = quadrant(1, -1)        // 4
let in_range = between(5, 1, 10)    // true
let below = between(0, 1, 10)       // false
let above = between(11, 1, 10)      // false
