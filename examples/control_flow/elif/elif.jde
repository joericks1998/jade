fn classify(x) {
    if x > 0 {
        return 1
    } elif x < 0 {
        return -1
    } else {
        return 0
    }
}

fn grade(score) {
    if score >= 90 {
        return 4
    } elif score >= 80 {
        return 3
    } elif score >= 70 {
        return 2
    } elif score >= 60 {
        return 1
    } else {
        return 0
    }
}

let pos = classify(5)       // 1
let neg = classify(-3)      // -1
let zero = classify(0)      // 0

let a = grade(95)           // 4
let b = grade(85)           // 3
let c = grade(75)           // 2
let d = grade(65)           // 1
let f = grade(50)           // 0
