// Everything std::string gained in v1.3.23, in both spellings.
//
// Two things this fixture exists to pin.
//
// Every index is a *character* index. `len()` counts characters and `s[i]`
// walks them, so an index that answered a byte offset would agree with `len` on
// "hello" and disagree on the first accented string anyone tried. Rust's own
// `find` answers bytes, so this is a real trap rather than a theoretical one —
// hence the accented cases beside every ASCII one.
//
// And `slice` is the one method name that does not settle its receiver's kind:
// a blob has it too. Compiled code cannot pick the arm from the name, so the
// whole tagged word goes to the runtime, which reads the tag. This file calls
// it on a string and on a blob in the same program, which is what proves the
// dispatch rather than one lucky arm.

use std::string

// Trimming one end.
print("  x  ".trim_start())
print("  x  ".trim_end())
print(string.trim_start("  y  "))
print(string.trim_end("  y  "))

// Searching. -1 when absent, because the answer is an int either way and Jade
// has no option type to do better with.
print("hello".index_of("l"))
print("hello".last_index_of("l"))
print("hello".index_of("zz"))
print("café!".index_of("!"))
print("café!é".last_index_of("é"))
print(string.index_of("hello", "l"))

// Counting is non-overlapping, and an empty needle answers 0 rather than the
// length plus one.
print("banana".count("an"))
print("aaaa".count("aa"))
print("abc".count(""))
print(string.count("banana", "a"))

// Emptiness.
print("".is_empty())
print("x".is_empty())
print(string.is_empty(""))

// Repetition. Zero or negative gives the empty string rather than raising.
print("ab".repeat(3))
print("ab".repeat(0))
print("ab".repeat(-1))
print(string.repeat("z", 2))

// Slicing, clamped at both ends and in either order.
print("hello".slice(1, 3))
print("hello".slice(-3, 99))
print("hello".slice(3, 1))
print("café".slice(3, 4))
print(string.slice("hello", 0, 2))

// The same method on a blob, in the same program — this is the dispatch test.
let blob = "hello world".encode()
print(blob.slice(0, 5).decode())

// Padding counts characters, never truncates, and cuts a multi-character pad
// to fit.
print("7".pad_start(3, "0"))
print("7".pad_end(3, "0"))
print("café".pad_start(6, "."))
print("abcd".pad_start(2, "0"))
print("x".pad_start(5, "ab"))
print(string.pad_start("5", 3, "0"))

// Capitalize uses the full case mapping, so an accented first letter works.
print("hello world".capitalize())
print("HELLO".capitalize())
print("élan".capitalize())
print(string.capitalize("hello"))
