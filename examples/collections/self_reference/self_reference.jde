// A structure that points back at itself is built from a struct.
//
// In v1, arrays and dicts were untyped and reference-semantic, so
// `let a = [1]  let b = [a]  a.push(b)` built a value that reached itself, and
// printing it had to stop at a fixed depth and elide the rest. In v2 every array
// has one element type, and an array holding itself would need a type that
// contains itself, so the checker refuses it; self_reference_error.jde pins
// that. A struct's type is a name, so a struct field can hold the struct it
// belongs to, and a cycle through one is an ordinary live value.

struct Node {
    name
    let children = []
}

let root = Node { name: "root" }
root.children.push(root)

// The value is intact, and reaching it back through itself works.
print(len(root.children))
print(root.children[0].name)
// → 1
// → root

// Ordinary nesting serializes and prints as before.
use std::json

print(json.stringify([[1], [2, 3]]))
print([[1], [2, 3]])
print({"k": [1, 2]})
// → [[1],[2,3]]
// → [[1], [2, 3]]
// → {"k": [1, 2]}
