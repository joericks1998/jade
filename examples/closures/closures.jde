// What closures did, written without them.
//
// Closures were removed in 2.0.1. A named function is a value that can be
// passed and stored, and the pipe passes a value as a function's first
// argument, so `5 |> scale(3)` is `scale(5, 3)`. State a closure would have
// captured becomes an argument. closure_error.jde shows the refusal.

// An inline function becomes a named one.
fn double(x) { x * 2 }
print(double(5))

fn add(x, y) { x + y }
print(add(3, 4))

fn greet() { "hello" }
print(greet())

// A captured variable becomes an argument, and the pipe supplies the value.
fn scale(x, by) { x * by }
let multiplier = 3
print(5 |> scale(multiplier))

// A block body is an ordinary function body.
fn abs_val(x) {
    if x < 0 {
        return -x
    }
    return x
}
print(abs_val(-7))
print(abs_val(4))
