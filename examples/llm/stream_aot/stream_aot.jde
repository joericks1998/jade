// A grammar around a whole dereference constrains how the model writes it.
//
// `g(?p)` sends `g`'s grammar with the request, the way `toInt(?p)` asks for an
// int, and the reply arrives whole, like any typed dereference. A pipe straight
// after `?p` runs once per piece of an unconstrained reply instead.
//
// This used to be spelled `?p |> g`, which streamed the constrained reply and
// hid the text between the grammar's anchors, "<t>" and "</t>", while it
// printed. A pipe now always runs per piece, so a grammar wraps the reply. v2
// does not compile grammars yet.

prompt p = "Reply with <t>a</t> and nothing else."

let g = Grammar.new("\"a\"|\"b\"", "<t>", "</t>")

print(g(?p))

let out = g(?p)
print(len(out) > 0)
