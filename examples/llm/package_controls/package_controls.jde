// Expanded `llm` package — 1.1.12. Backed by the jade inference daemon over
// ~/.jade/llm.sock, consuming the daemon's `jade-protocol` and
// `jade-model-profile` crates as git dependencies.
//
// Fixture-first: this documents the intended Jade-facing API. Contract:
// design/llm-package-1.1.12.md.
//
// Surfaces the language still owns (all resolve at runtime through the daemon):
//   1. active model      llm.model()                        (introspection)
//   2. protocol controls llm.set_max_tokens(n), llm.keep_anchors(b)
//   3. token & stats      llm.count_tokens(s), llm.total_tokens()
//   4. daemon lifecycle   llm.health()                      (wire op)
//
// Tool-call PARSING and per-model profiles are no longer language builtins —
// they are model-specific, so they ship with each model as a Jade profile
// package. A program imports the profile for the model it targets and calls,
// e.g., `profile.find_tool_call(reply)`. See the model's own profile package.

use llm


// ── 1. Active model (read-only introspection) ────────────────────────────────
// The name the daemon reports in its Meta frame after the first inference.

print(llm.model())            // → "Qwen3-Coder-30B"


// ── 2. Protocol controls (sticky VM session state) ───────────────────────────
// These flow into every subsequent prompt's infer request.

llm.set_max_tokens(512)       // existing scalar setter, kept

// Make the tool-span boundary observable in-band so a client can delimit
// <tool>…</tool> by string match (jade-protocol `keep_anchors`).
llm.keep_anchors(true)

// grammar/anchor are already available via  ?p |> grammar
let p = prompt "What is 2 + 2? Respond with only the number."
print(?p)                     // → 4


// ── 3. Token & stats ─────────────────────────────────────────────────────────

let n = llm.count_tokens("how many tokens is this?")
print(n)                      // → e.g. 7

let total = llm.total_tokens()
print(total)


// ── 4. Daemon lifecycle (new `health` op) ────────────────────────────────────

let h = llm.health()
print(h.status)        // → "ok" | "degraded" | "loading" | "error"
print(h.model)         // → "Qwen3-Coder-30B"
print(h.model_loaded)  // → true
print(h.uptime_secs)   // → 12345
