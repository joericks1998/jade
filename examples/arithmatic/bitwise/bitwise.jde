let and_op = 6 & 3           // 2   (110 & 011 = 010)
let or_op = 6 | 3            // 7   (110 | 011 = 111)
let xor_op = 6 ^ 3           // 5   (110 ^ 011 = 101)
let shl_op = 1 << 3          // 8
let shr_op = 16 >> 2         // 4

// precedence: shifts bind tighter than & | ^
let chained_bits = 6 & 7 | 1      // 7   (6&7=6, 6|1=7)
let shift_then_and = 1 << 4 & 24  // 16  (1<<4=16, 16&24=16)
