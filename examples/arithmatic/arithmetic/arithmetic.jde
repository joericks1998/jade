let add_int = 3 + 4          // 7
let sub_int = 10 - 3         // 7
let mul_int = 3 * 4          // 12
let div_int = 10 / 2         // 5
let mod_int = 10 % 3         // 1

let add_float = 1.5 + 2.5    // 4.0
let sub_float = 5.0 - 1.5    // 3.5
let mul_float = 2.0 * 3.5    // 7.0
let div_float = 5.0 / 2.0    // 2.5
let mod_float = 5.0 % 2.0    // 1.0

// int + float promotes to float
let promoted_add = 1 + 0.5   // 1.5
let promoted_mul = 2 * 1.5   // 3.0
let promoted_div = 5 / 2.0   // 2.5
let promoted_sub = 3.0 - 1   // 2.0

// operator precedence: * before +
let chained = 2 + 3 * 4      // 14
let grouped = (2 + 3) * 4    // 20
