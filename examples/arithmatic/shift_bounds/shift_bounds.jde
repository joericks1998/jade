// A shift checks its amount and its result, identically on both engines.
//
// Compiled code used to untag both operands and emit the bare machine shift.
// LLVM leaves a shift by 64 or more undefined, so `1 << 64` produced a garbage
// word that `print` then followed as a pointer — a segfault where `jade run`
// raised. `1 << 62` was worse for being quiet: it is 2^62, one past the largest
// Jade integer, and the two engines printed different numbers for it rather
// than either of them raising. The same lowering covered `&`, `|` and `^`, so
// `"x" & 1` answered with a number made of the string's pointer bits.

// Ordinary shifts are unaffected.
print(1 << 3)
print(16 >> 2)
print(-1 >> 5)
// → 8
// → 4
// → -1

// An amount outside 0..64 is an error, not undefined behaviour.
try {
    let x = 1 << 64
    print(x)
} catch e {
    print("shift amount refused")
}
// → shift amount refused

try {
    let x = 1 >> -1
    print(x)
} catch e {
    print("negative amount refused")
}
// → negative amount refused

// Jade integers are 63-bit, so a result past the range overflows like any other
// arithmetic rather than wrapping.
try {
    let x = 1 << 62
    print(x)
} catch e {
    print("shift overflow caught")
}
// → shift overflow caught

// The largest shift that still fits.
print(1 << 61)
// → 2305843009213693952

// Bitwise and shift are int-only on both engines, including when the operands
// reach the operator with no static type.
fn band(a, b) {
    return a & b
}

fn shl(a, b) {
    return a << b
}

print(band(6, 3))
// → 2

try {
    print(band("x", 1))
} catch e {
    print("non-int operand refused")
}
// → non-int operand refused

try {
    print(shl(1, 70))
} catch e {
    print("dynamic shift amount refused")
}
// → dynamic shift amount refused
