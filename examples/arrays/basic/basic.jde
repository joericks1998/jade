// ── arrays ────────────────────────────────────────────────────────────────────

// Array literal
let a = [1, 2, 3]
print(a)   // [1, 2, 3]

// Empty array
let empty = []
print(empty)   // []

// Arrays are homogeneous — every element must share one type. Mixing them is a
// compile-time error, caught by type inference before the program runs:
//   let mixed = [1, 2.0, true]   // error: heterogeneous array:
//                                //        first element is int, found float
let floats = [1.0, 2.0, 3.0]
print(floats)   // [1.0, 2.0, 3.0]

// Indexing — zero-based
print(a[0])   // 1
print(a[2])   // 3

// len builtin works on arrays and strings
print(len(a))        // 3
print(len(empty))    // 0
print(len("hello"))  // 5

// Index assignment — REFERENCE semantics: assignment creates an alias, it does
// not copy. Mutating through one name is visible through the other.
let b = a
b[0] = 42
print(b[0])   // 42
print(a[0])   // 42  (a sees the write — a and b are the same array)

// Mutate a directly
a[1] = 99
print(a[1])   // 99

// Trailing comma is allowed
let t = [10, 20, 30,]
print(len(t))   // 3

// Nested arrays
let matrix = [[1, 2], [3, 4]]
print(matrix[0][1])   // 2
print(matrix[1][0])   // 3

// Arrays in functions
fn sum(arr, n) {
    let i = 0
    let total = 0
    while i < n {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

let nums = [10, 20, 30]
print(sum(nums, len(nums)))   // 60
