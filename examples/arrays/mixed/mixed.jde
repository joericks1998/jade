// An array holds one kind of value.
//
// Until v2, a literal could mix kinds, as in [1, 2.0, true, "hello", nil]. Every
// value now has one type the compiler knows, so a mixed literal is a type error;
// mixed_error.jde pins that.
//
// Mixed arrays were added for one case: a reply that is several Token frames
// followed by a Done. That is several kinds of record in one list, which is what
// a shared parent struct says. The array's element type is the parent, and a
// method each kind defines answers for the value an element actually holds.

struct Frame {}
struct Token(Frame) { let text = "" }
struct Done(Frame) { let count = 0 }

extend Token {
    fn describe(self) {
        return f"token '{self.text}'"
    }
}

extend Done {
    fn describe(self) {
        return f"done after {self.count}"
    }
}

let frames = [Token { text: "hi" }, Token { text: " there" }, Done { count: 2 }]
print(len(frames))
for fr in frames {
    print(fr.describe())
}

// Numbers of one kind sort as numbers. Writing 3.0 rather than 3 keeps every
// element a float.
let nums = [3.0, 1.5, 2.0]
nums.sort()
print(nums)

// An array of arrays is one kind too.
let nested = [[1, 2], [3]]
print(nested)
print(nested[0][1])
